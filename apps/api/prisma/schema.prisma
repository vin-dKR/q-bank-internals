// Own MongoDB for the internal pipeline. Mirrors the shape of @ingest/contracts so the boundary stays honest.
// Generated client is git-ignored (src/infrastructure/database/generated). Run `npm run prisma:generate`.
//
// NOTE: this database is shared with the main Eduents app, so every ingest model is @@map'd to an
// `ingest_*` collection. In particular the extracted questions live in `ingest_extracted_questions`
// (a TEMPORARY staging collection) so they never collide with the main app's `Question` collection —
// the final "publish" step is what promotes verified questions into the real bank.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum DocumentStatus {
  uploaded
  queued
  extracting
  extracted
  needs_review
  approved
  published
  completed
  failed
}

type SourcePath {
  module  String
  chapter String
  section String
}

// The page span (1-based, inclusive) a section occupies within its source PDF.
type PageRange {
  from Int
  to   Int
}

// One operator's Phase-1 upload run (e.g. a whole module). The durable, resumable unit: Phase 1
// fills it fast; Phase 2 drains it later, manually or automatically when autoRun is set.
// Status + document/extracted counts are derived from child documents at read time, not stored,
// so they can never drift from the documents they summarise.
model Session {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  label     String
  exam      String?
  subject   String?
  module    String?
  autoRun   Boolean    @default(false)
  documents Document[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("ingest_sessions")
}

model Document {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  session       Session?        @relation(fields: [sessionId], references: [id])
  sessionId     String?         @db.ObjectId
  driveFileId   String          @unique
  fileName      String
  path          SourcePath
  kind          String          @default("question")
  sectionName   String?
  questionType  String?
  pageRange     PageRange?
  status        DocumentStatus  @default(uploaded)
  questionCount Int             @default(0)
  extractedAt   DateTime?
  questions     Question[]
  jobs          ExtractionJob[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("ingest_documents")
}

type QuestionOption {
  label     String
  body      String
  isCorrect Boolean
}

type QuestionImage {
  driveFileId String
  alt         String
}

type SourceRegion {
  page Int
  bbox Float[]
}

model Question {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  document        Document         @relation(fields: [documentId], references: [id])
  documentId      String           @db.ObjectId
  path            SourcePath
  stem            String
  options         QuestionOption[]
  answer          String
  images          QuestionImage[]
  isQuestionImage Boolean          @default(false)
  questionImage   String?
  isOptionImage   Boolean          @default(false)
  optionImages    String[]
  questionType    String?
  sectionName     String?
  topic           String?
  sourceRegion    SourceRegion
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // TEMPORARY staging collection — verified questions are promoted to the main bank on publish.
  @@map("ingest_extracted_questions")
}

model ExtractionJob {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  document      Document @relation(fields: [documentId], references: [id])
  documentId    String   @db.ObjectId
  status        String   @default("queued")
  model         String
  questionsFound Int     @default(0)
  error         String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime @default(now())

  @@map("ingest_extraction_jobs")
}
