{
  "name": "@ingest/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express backend: registers Drive PDFs, runs AI extraction, serves questions for verification.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "build:vercel": "prisma generate && node scripts/build-vercel.mjs"
  },
  "dependencies": {
    "@ingest/contracts": "*",
    "@prisma/client": "^6.2.0",
    "@supabase/supabase-js": "^2.112.0",
    "bullmq": "^5.81.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "multer": "^2.0.1",
    "openai": "^4.104.0",
    "pdf-to-img": "^4.5.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.0",
    "prisma": "^6.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
