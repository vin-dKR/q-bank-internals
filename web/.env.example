# Copy to web/.env — never commit the filled version.
# The one build-time config the web app reads (src/config/env.ts).

# In dev, leave this unset: the app calls `/api` and Vite proxies to the API on :4000 (vite.config.ts).
# In production (Vercel), point it at the deployed API, e.g. https://<your-api>.vercel.app/api
VITE_API_BASE_URL=
