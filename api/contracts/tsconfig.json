{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // Compiles src → dist for plain-Node consumers (Vercel serverless, `node dist`). Dev tooling
    // (tsx, Vite dev, tsc typecheck) never reads dist — the `types`/`development` export conditions
    // keep them on the live .ts source. Options mirror the strictness of both consuming apps.
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": ["src"]
}
