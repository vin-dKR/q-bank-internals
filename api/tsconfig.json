{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // Self-contained (this app no longer extends a shared root config). NodeNext so the `.js` import
    // specifiers resolve to their `.ts` sources; these are also the exact options Vercel's function
    // builder (@vercel/node) compiles `api/index.ts` with — it reads THIS file, at the app root.
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "outDir": "./dist"
  },
  "include": ["src", "api"]
}
