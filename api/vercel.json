{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --include=dev",
  "buildCommand": "node scripts/check-env.mjs && npm run prisma:generate && npm run build:contracts",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "node_modules/{.prisma/client,pdfjs-dist}/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
