{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --include=dev",
  "buildCommand": "node scripts/check-env.mjs && npm run prisma:generate && npm run build:contracts",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "node_modules/{.prisma/client,pdfjs-dist,tesseract.js,tesseract.js-core,@tesseract.js-data/eng,bmp-js,wasm-feature-detect}/**"
    },
    "api/extraction-queue.ts": {
      "maxDuration": 300,
      "includeFiles": "node_modules/{.prisma/client,pdfjs-dist}/**",
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "ingest-extraction",
          "retryAfterSeconds": 60
        }
      ]
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
