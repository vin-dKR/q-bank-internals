{
  "name": "@ingest/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express backend: registers Drive PDFs, runs AI extraction, serves questions for verification. Standalone app.",
  "main": "dist/src/main.js",
  "scripts": {
    "dev": "tsx watch --conditions=development src/main.ts",
    "worker": "tsx watch --conditions=development src/worker.ts",
    "build:contracts": "tsc -p contracts",
    "prebuild": "npm run build:contracts",
    "build": "tsc",
    "start": "node dist/src/main.js",
    "start:worker": "node dist/src/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@ingest/contracts": "file:./contracts",
    "@prisma/client": "^6.2.0",
    "@supabase/supabase-js": "^2.112.0",
    "bullmq": "^5.81.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "multer": "^2.0.1",
    "openai": "^4.104.0",
    "pdf-to-img": "^4.5.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.35.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "prisma": "^6.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "canvas@3.1.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "msgpackr-extract@3.0.4": true,
    "prisma@6.19.3": true
  }
}
