# Copy to api/.env — never commit the filled version.
# Every variable here is parsed and validated ONCE in src/config/env.ts.

# --- runtime ---
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# --- database (own MongoDB for this internal tool) ---
# `memory` boots with no external services (dev default). Set `mongo` for durable, resumable sessions.
DB_DRIVER=memory
DATABASE_URL="mongodb+srv://user:pass@cluster/ingest?retryWrites=true&w=majority"

# --- google drive ---
# Where cut chapters are filed (a folder id in the target Drive).
DRIVE_ROOT_FOLDER_ID=

# Preferred for personal Gmail: OAuth "act as you" — uploads are owned by your account (has quota).
# Get the refresh token once: node scripts/get-drive-refresh-token.mjs <ID> <SECRET>
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Fallback: service account (can browse/create folders but CANNOT upload files — no storage quota).
# Only useful when DRIVE_ROOT_FOLDER_ID points inside a Google Workspace Shared Drive.
# NOTE: reads a key file from disk — does not work on Vercel serverless; use the OAuth vars there.
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/drive-service-account.json

# --- ai vision extraction (Phase 2 worker) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional local override when OPENAI_API_KEY is already set in the OS environment.
OPENAI_API_KEY_2=
EXTRACTION_MODEL=gpt-5.4-mini
# Text-only heading normalization is tuned separately from page extraction. Increase only after
# comparing against reviewed OCR samples for the source/provider.
STRUCTURE_MODEL=gpt-5.4-mini
STRUCTURE_REASONING_EFFORT=low
STRUCTURE_MAX_COMPLETION_TOKENS=2000
STRUCTURE_AI_TIMEOUT_MS=60000
# Tesseract heading-crop OCR: warn on low confidence and time out per crop.
STRUCTURE_OCR_MIN_CONFIDENCE=70
STRUCTURE_OCR_TIMEOUT_MS=45000
# Local API / standalone BullMQ worker deadline. Large PDFs can take several minutes. Vercel's
# synchronous fallback caps itself at four minutes regardless, to return a persisted result safely.
EXTRACTION_TIMEOUT_MS=900000

# --- queue (BullMQ) ---
# Absent → in-process queue: extraction runs inside the API (dev, no Redis needed).
# Set it → the API only enqueues, including on Vercel; run a separate worker with `npm run worker`
# (or `start:worker`) on a long-running host. This is required for production jobs beyond Vercel's
# serverless request limit.
REDIS_URL=redis://localhost:6379
