// Own MongoDB for the internal pipeline. Mirrors the shape of @ingest/contracts so the boundary stays honest.
// Generated client is git-ignored (src/infrastructure/database/generated). Run `npm run prisma:generate`.
//
// NOTE: this database is shared with the main Eduents app, so every ingest model is @@map'd to an
// `ingest_*` collection. In particular the extracted questions live in `ingest_extracted_questions`
// (a TEMPORARY staging collection) so they never collide with the main app's `Question` collection —
// the final "publish" step is what promotes verified questions into the real bank.

generator client {
  provider = "prisma-client-js"
  // "native" for local dev; "rhel-openssl-3.0.x" is the engine Vercel's Node 20 serverless runtime
  // needs. Without it the client throws "Query engine binary could not be found" in production.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum DocumentStatus {
  uploaded
  queued
  extracting
  extracted
  needs_review
  approved
  published
  completed
  failed
}

type SourcePath {
  module  String
  chapter String
  section String
}

// The page span (1-based, inclusive) a section occupies within its source PDF.
type PageRange {
  from Int
  to   Int
}

// One question-type block inside a topic: a predefined type bound to the page span it occupies in
// the uploaded question PDF. Fixed by the operator at cut time; consumed by extraction so the model
// never picks or invents a type.
type TopicTypeConfig {
  // Optional: a PYQ paper's questions are of mixed types, so its segments leave this blank.
  questionType String?
  pageRange    PageRange
  // The same topic's spans in the sibling answer / solution PDFs (v2 assembled uploads), so the
  // extractor reads this topic's key from exactly its own pages instead of guessing by name/number.
  answerPageRange   PageRange?
  solutionPageRange PageRange?
  // One grouped Answer + Solution companion PDF uses this one source span for the same topic.
  // The Verify API still asks the caller whether a crop/re-read is for Answer or Solution.
  companionPageRange PageRange?
  // Operator's per-node PYQ toggle for this segment: when set, extraction reads each question's source
  // exam + year off the page. Absent/false on ordinary segments and legacy uploads.
  pyq               Boolean?
}

// Paper-level provenance for a previous-year-questions upload: describes the WHOLE paper the
// questions came from (exam name/year/session/shift/paper code …), entered once at cut time
// (optionally AI-filled) and denormalized onto the document and every question. Every field optional.
type PaperMetadata {
  pyqExamName        String?
  pyqExamYear        String?
  pyqExamSession     String?
  pyqShift           String?
  pyqPaperName       String?
  pyqPaperCode       String?
  pyqConductingBody  String?
  pyqExamStage       String?
  pyqExamDate        String?
  pyqPaperSet        String?
  pyqLanguage        String?
  pyqTotalQuestions  String?
  pyqDuration        String?
  pyqTotalMarks      String?
}

// One topic inside a chapter PDF (Chapter -> Section -> Part -> Topic -> Questions). `name` is the
// unique per-leaf answer-matching key (full joined path); sectionName/topicName are the split display
// identity (Section node label -> bank section_name; Topic leaf label -> bank topic). Both optional.
type ChapterTopic {
  name        String
  types       TopicTypeConfig[]
  sectionName String?
  topicName   String?
  // Operator's per-node subject for this leaf → each question's subject (a PYQ paper spans subjects).
  subject     String?
}

// One operator's Phase-1 upload run (e.g. a whole module). The durable, resumable unit: Phase 1
// fills it fast; Phase 2 drains it later, manually or automatically when autoRun is set.
// Status + document/extracted counts are derived from child documents at read time, not stored,
// so they can never drift from the documents they summarise.
model Session {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  label     String
  exam      String?
  subject   String?
  module    String?
  autoRun   Boolean    @default(false)
  documents Document[]
  // Soft-delete tombstone: set when the operator removes the session so it hides from listings but
  // its documents + published questions survive and can be restored by editing a published question.
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("ingest_sessions")
}

model Document {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  session       Session?        @relation(fields: [sessionId], references: [id])
  sessionId     String?         @db.ObjectId
  driveFileId   String          @unique
  fileName      String
  // The upload's identity within its session: shared by the question/answer/solution parts of one
  // upload action, fresh per upload. Not filename/path-derived, so uploading the same file twice makes
  // two distinct documents. Empty on legacy rows (they fall back to unit-path sibling matching).
  uploadGroupId String          @default("")
  path          SourcePath
  kind          String          @default("question")
  sectionName   String?
  questionType  String?
  // Exam + subject the operator picked for this chapter, persisted per-document so publish stamps the
  // authoritative values onto each bank row (the session's copy is only a filter-option hint). Null on legacy docs.
  exam          String?
  // CBSE grade selected at cut time (e.g. "Class 10"). Null for other exams and legacy rows.
  className     String?
  subject       String?
  // PYQ provenance chosen at cut time: whether the chapter's questions are previous-year questions,
  // and the exam + year they were asked in. Carried to the bank row on publish. Null/false on legacy docs.
  pyq           Boolean         @default(false)
  pyqExam       String?
  pyqYear       String?
  // Paper-level PYQ provenance (exam name/year/session/shift/paper code …); absent when not a PYQ upload.
  paper         PaperMetadata?
  // How answers are laid out: separate sibling PDFs, one grouped "combined" companion, or inline
  // (each question followed by its own answer). Drives extraction and Verify source routing.
  answerLayout  String          @default("separate")
  // Question provenance chosen at cut time: pyq / module / textbook (open string). Null on legacy docs.
  source        String?
  pageRange     PageRange?
  // Missing on pre-topic documents; Prisma reads an absent composite list as [] (config absent).
  topics        ChapterTopic[]
  status        DocumentStatus  @default(uploaded)
  // Operator flag: a file that didn't extract cleanly, marked to be fixed manually later.
  flagged       Boolean         @default(false)
  questionCount Int             @default(0)
  extractedAt   DateTime?
  // Soft-delete tombstone: set when the document (or its session) is removed, so it hides from
  // listings while its extracted questions survive and it can be restored by editing a published one.
  deletedAt     DateTime?
  questions     Question[]
  jobs          ExtractionJob[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("ingest_documents")
}

type QuestionOption {
  label     String
  body      String
  isCorrect Boolean
  // True only for matrix choices generated deterministically from the structured matching key.
  // Optional so every legacy/printed option remains source-authored by default; false marks a
  // teacher-authored replacement while true remains safe for automatic regeneration.
  generated Boolean?
}

type QuestionImage {
  driveFileId String
  alt         String
}

type SourceRegion {
  page Int
  bbox Float[]
}

model Question {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  document        Document         @relation(fields: [documentId], references: [id])
  documentId      String           @db.ObjectId
  questionNumber  Int?
  path            SourcePath
  stem            String
  options         QuestionOption[]
  answer          String
  explanation     String?
  // Structured match-the-column data ({ columns, key }) for MATRIX MATCH questions; null otherwise.
  // Stored as Json so the nested columns + the label→labels key map need no composite-type schema.
  match           Json?
  // Comprehension grouping (BLA-125, v2). Each sub-question of a shared-passage block is its own row,
  // carrying its OWN real questionType; membership in a group is `passageId != null` (NOT a per-row
  // type). The shared passage text + image live ONCE in the `Passage` model (below), referenced by
  // `passageId` (= that Passage's stable id, which doubles as the bank group_id on publish). `groupOrder`
  // is this sub-question's 0-based position within its group. Both null on ordinary questions.
  passageId       String?
  groupOrder      Int?
  images          QuestionImage[]
  isQuestionImage Boolean          @default(false)
  questionImage   String?
  isOptionImage   Boolean          @default(false)
  optionImages    String[]
  // Figures cropped from the sibling answer-key PDF.
  answerImages    String[]
  // Figures attached to the worked solution/explanation (Supabase URLs), published into the bank's
  // `solution_image` field. Empty on older rows.
  explanationImages String[]
  // Persisted crop rectangles (natural image pixels) for the attached figures, as [{ url, type,
  // optionIndex, nx, ny, nw, nh }]. Ingest-only; lets a saved crop reappear as an editable box on any
  // device. Json so the array of rects needs no composite-type schema. Absent on older rows.
  imageCrops      Json?
  questionType    String?
  // Per-question difficulty (easy|medium|hard) the AI classifies at extraction; corrected on Verify and
  // resolved to the bank's Level FK on publish. Null on rows extracted before difficulty existed.
  level           String?
  sectionName     String?
  topic           String?
  // Which of topic/answer/solution/level hold an AI-written value: { answer: { model, confidence, at, via } }.
  // Written by the quality screens, cleared per field when an operator edits it, published as `ai_filled`.
  aiFilled        Json?
  // CBSE grade copied from the source document when the question is extracted. Null otherwise.
  className       String?
  // Per-question subject (a PYQ paper spans subjects), set per node in the structure tree. Null on
  // ordinary questions and legacy rows — publish falls back to the document's subject.
  subject         String?
  // Marked on the Verify screen to flag a question for later attention; carried to the bank on publish.
  flagged         Boolean          @default(false)
  // Per-question PYQ provenance the model read off the page when this question's segment is PYQ: the
  // flag plus the SOURCE exam + year it originally appeared in. Separate from the document-level target
  // exam/subject. Defaults/null on ordinary questions and legacy rows (publish falls back to document).
  isPyq           Boolean          @default(false)
  pyqExam         String?
  pyqYear         String?
  // Paper-level PYQ provenance denormalized from the document, so every published question carries the
  // paper it came from. Absent on non-PYQ and legacy rows.
  paper           PaperMetadata?
  sourceRegion    SourceRegion
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Comprehension re-extraction fetches a whole group by its shared passageId within a document.
  @@index([documentId, passageId])
  // TEMPORARY staging collection — verified questions are promoted to the main bank on publish.
  @@map("ingest_extracted_questions")
}

// The shared passage of a comprehension block (BLA-125, v2), stored ONCE and referenced by every
// sub-question via Question.passageId. Normalizing the passage here (instead of copying its text onto
// every sibling row) makes a single edit atomic and the group a real entity. `id` is deterministic —
// sha1(documentId + "\n" + normalized text) sliced to 24 chars, the SAME value stamped as the bank
// group_id on publish — so re-extraction/re-publish stays idempotent. `text` is the LaTeX-bearing
// passage; `passageImage` is the one shared figure (Supabase URL); `imageCrops` persists its crop rects
// so the box re-materialises on the verify canvas. `contentHash` is the within-document dedup key.
// TEMPORARY staging collection — the passage text is collapsed back onto each bank row on publish.
model Passage {
  id           String   @id @map("_id")
  documentId   String   @db.ObjectId
  text         String
  contentHash  String
  passageImage String?
  imageCrops   Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([documentId])
  @@map("ingest_passages")
}

model ExtractionJob {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  document      Document @relation(fields: [documentId], references: [id])
  documentId    String   @db.ObjectId
  status        String   @default("queued")
  model         String
  questionsFound Int     @default(0)
  pagesTotal    Int      @default(0)
  pagesDone     Int      @default(0)
  error         String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime @default(now())

  @@map("ingest_extraction_jobs")
}

// Durable checkpoints for a single extraction job. A page is committed here immediately after the
// vision response succeeds, before the next page is queued. This is intentionally separate from
// `Question`: final question rows are written only once all page drafts have been reconciled with
// answers/solutions, but a timeout, pause, or deployment can never make us pay to read a completed
// page again. Mongo creates this collection lazily, so deploying the generated client is sufficient.
model ExtractionPageDraft {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  jobId          String   @db.ObjectId
  documentId     String   @db.ObjectId
  phase          String
  pageNumber     Int
  scopeKey       String
  data           Json
  questionCount  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([jobId, documentId, phase, pageNumber, scopeKey])
  @@index([jobId, phase])
  @@map("ingest_extraction_page_drafts")
}

// An operator's edit to one AI prompt, keyed by its PromptKey. Absent = the code default is used.
// Read by the prompt builders (cached briefly) and managed from the prompt-settings screen.
model PromptOverride {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("ingest_prompt_overrides")
}

// One OpenAI call's token spend, appended by the extraction pipeline (vision extraction or LaTeX
// refinement). Queried by UTC-day windows for the Usage dashboard and to enforce the global budget,
// so createdAt is indexed. documentId/sessionId are loose string references (no relation) — a usage
// row is an immutable fact and must outlive the document it describes.
model TokenUsage {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  source           String
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  callCount        Int      @default(1)
  documentId       String?  @db.ObjectId
  sessionId        String?  @db.ObjectId
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@map("ingest_token_usage")
}

// One tracked data-quality problem on a LIVE shared-bank `Question` row, written by a quality scan. `key`
// (questionId|kind|field) is the identity a re-scan matches on, so the same problem keeps its row, its
// firstSeenAt, and an operator's `ignored` decision across scans. The exam/subject/…/preview columns are a
// snapshot from the last scan that saw it. questionId is a loose reference: the bank has no Prisma model.
model QualityAnomaly {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  key              String    @unique
  questionId       String
  ingestQuestionId String?
  documentId       String?
  kind             String
  group            String
  severity         String
  field            String?
  detail           String
  status           String
  exam             String?
  subject          String?
  chapter          String?
  questionType     String?
  questionNumber   Int?
  fileName         String?
  preview          String
  firstSeenAt      DateTime
  lastSeenAt       DateTime
  resolvedAt       DateTime?

  @@index([status, group, kind])
  @@index([questionId])
  @@map("ingest_quality_anomalies")
}

// One AI proposal for a live bank question, parked for review. A batch run writes these, never the bank;
// applying an approved proposal is what writes the question (and its staging copy). One row per question —
// re-running replaces the previous pending proposal rather than stacking duplicates.
model QualityAiProposal {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  questionId       String    @unique
  ingestQuestionId String?
  fields           String[]
  topic            String?
  answer           String?
  solution         String?
  level            String?
  // What the bank holds today, so the review shows before → after without re-reading every question.
  currentTopic     String?
  currentAnswer    String?
  currentLevel     String?
  subject          String?
  chapter          String?
  questionNumber   Int?
  preview          String
  confidence       Float
  notes            String
  usedImage        Boolean   @default(false)
  // The model that produced the proposal; stamped on the question's AI-filled tag when it is applied.
  model            String?
  // The rebuilt structure ({ match, passage }) when the run was asked for it; null otherwise.
  structure        Json?
  status           String
  createdAt        DateTime  @default(now())
  decidedAt        DateTime?

  @@index([status, createdAt])
  @@map("ingest_quality_ai_proposals")
}

// One run of the quality scan. A `running` row older than the stale window is treated as crashed.
model QualityScan {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  status           String
  startedAt        DateTime
  finishedAt       DateTime?
  questionsScanned Int       @default(0)
  anomaliesFound   Int       @default(0)
  opened           Int       @default(0)
  reopened         Int       @default(0)
  resolved         Int       @default(0)
  // Optional: scans recorded before this counter existed have no value (read back as 0).
  removed          Int?
  error            String?

  @@index([startedAt])
  @@map("ingest_quality_scans")
}

// The single global token budget. A null cap means "no limit on that window". One row; the service
// upserts it. dailyLimit/weeklyLimit are counts of total tokens per UTC-day / trailing-7-day window.
model TokenLimit {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  dailyLimit  Int?
  weeklyLimit Int?
  updatedAt   DateTime @updatedAt

  @@map("ingest_token_limits")
}
