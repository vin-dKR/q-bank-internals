# Copy to apps/api/.env — never commit the filled version.
# Every variable here is parsed and validated ONCE in apps/api/src/config/env.ts.

# --- runtime ---
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# --- database (own MongoDB for this internal tool) ---
# `memory` boots with no external services (dev default). Set `mongo` for durable, resumable sessions.
DB_DRIVER=memory
DATABASE_URL="mongodb+srv://user:pass@cluster/ingest?retryWrites=true&w=majority"

# --- google drive ---
# Where cut chapters are filed (a folder id in the target Drive).
DRIVE_ROOT_FOLDER_ID=

# Preferred for personal Gmail: OAuth "act as you" — uploads are owned by your account (has quota).
# Get the refresh token once: node apps/api/scripts/get-drive-refresh-token.mjs <ID> <SECRET>
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Fallback: service account (can browse/create folders but CANNOT upload files — no storage quota).
# Only useful when DRIVE_ROOT_FOLDER_ID points inside a Google Workspace Shared Drive.
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/drive-service-account.json

# --- ai vision extraction (Phase 2 worker) ---
# The extraction worker uses OpenAI vision, ported from the standalone PDF Extractor.
GEMINI_API_KEY=
OPENAI_API_KEY=
EXTRACTION_MODEL=gpt-4o

# --- queue (BullMQ) ---
# Absent → in-process queue: extraction runs inside the API (dev, no Redis needed).
# Set it → the API only enqueues; run a separate worker with `npm run worker` (or start:worker).
REDIS_URL=redis://localhost:6379
